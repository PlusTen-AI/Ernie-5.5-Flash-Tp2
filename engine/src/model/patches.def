// patches.def — numbered engine patches, one line each. The base implementation always stays; a patch adds a variant
// (src/kernels/<family>/pNNN_<name>.cu(h) or a branch in model.cc) that must pass the correctness gate (lossless).
// Default on/off here; at run time E55_PATCHES="+name,-name" overrides. Numbers follow Plus (the Qwen3.8 engine) where
// the patch came from there; ERNIE's own patches take new numbers.
//
//        id  name        default  what it changes
E55_PATCH(1, rdma_ar,          true,  "every all-reduce (bf16 and fp32) over dual-rail RDMA WRITE with a CPU proxy instead of NCCL (no SMs) — from Plus; gate metrics identical to NCCL, decode −1 ms/step")
E55_PATCH(4, gemm_tune,        true,  "prefill: faster large-M MXFP8/bf16 GEMM tiles (same per-row arithmetic) — from Plus")
E55_PATCH(13, lin_pack12,      true,  "decode linear (M ≤ 64) reads a lossless 12-bit copy of bf16 weights (lm_head): 25% fewer bytes, same bits — from Plus")
E55_PATCH(16, block_verify,    true,  "spec_accept (T > 0, 1 ≤ k ≤ 15): block verification instead of token-by-token acceptance — same distribution — from Plus")
E55_PATCH(19, sparse_logits,   true,  "sampling / spec_accept from each vocab half's top-64 candidates instead of all-gathered full rows — same tokens — from Plus (kernels only)")
E55_PATCH(30, f8_decode,       true,  "FP8 block GEMM at M ≤ 32: weights streamed to registers 8 k32 blocks deep per warp, activation staged once, K splits summed in a thread-block cluster (no workspace / reduce launch) — same bits; decode GEMMs −9 % (cold, isolated)")
E55_PATCH(31, f8_prefill,      true,  "FP8 block GEMM at M > 32: 64×128 tiles, 2 CTAs/SM, both operands through a 3-stage cp.async pipeline, K splits chained in one CTA — same bits; M = 4096 110–134 TFLOPS (base 20–46)")
E55_PATCH(32, f8_fuse_act,     true,  "decode (M ≤ 8): the GEMM quantizes its bf16 activation itself instead of a separate act_quant launch — same bytes (needs the model.cc act() hook)")
E55_PATCH(33, f8_pdl,          true,  "decode FP8 GEMM launched as a programmatic dependent: its weight stream starts under the previous kernel (griddepcontrol.wait before the activation) — same bits")
E55_PATCH(34, f8_multi,        true,  "decode FP8 GEMMs on one activation (HCA q_up+gate, DSA q_b+gate+iq, MoE fc1+shared gate/up) as one launch — same bits (needs the model.cc call sites)")
E55_PATCH(35, moe_decode,      true,  "decode MoE experts (M ≤ 8): two launches (up; down + combine as a programmatic dependent) instead of six, the plan built in-kernel, weight stages in flight per warp — same bits")
E55_PATCH(36, route_fast,      true,  "MoE routing: per row two warp reductions per argmax round (redux max / min) instead of shuffle butterflies, 16 contiguous experts per lane — same ids, slots and weights")
E55_PATCH(37, moe_prefill,     true,  "prefill MoE experts (M > 64): 256 weight rows × 64 pairs a CTA, weights and activations through a 3-stage cp.async pipeline, two CTAs an SM (base: 64 rows, register loads, one CTA an SM) — same bits")
E55_PATCH(40, hca_vha_row,     true,  "hca_vha_out: one CTA per row, z kept in registers across the 32 heads (the base re-reads z per head) — same bits")
E55_PATCH(41, hca_attn_tc,     true,  "hca_attn: a row's chunks merged in-CTA (no fp32 partial round trip), K read straight from the FP8 rows, the 32-key softmax tiles of a 128-key pass in parallel, 8 CTAs per decode row (64-dim slices) — same bits")
E55_PATCH(42, hca_fuse,        true,  "HCA chain in 3 launches (model.cc): kv_rows + compress · q_prep + attention + vha_partial · vha_out + ring + state — same bits")
E55_PATCH(43, hca_attn_dec,    true,  "decode hca_attn (M ≤ 10): one 8-CTA cluster per row, the Q·Kᵀ chains split over the cluster, the scores exchanged through L2 behind one cluster barrier (each CTA: P·V of 64 dims) — same bits")
E55_PATCH(44, hca_compress_dec, true,  "with hca_fuse, decode (M ≤ 64): kv_rows + the group-closing compressor as one 8-CTA cluster per row (64 dims per CTA, the group staged in shared memory, the 16 RMS partial sums through L2) instead of one 512-thread CTA walking 3×128 tokens — same bits")
E55_PATCH(45, dsa_attn_fast,   true,  "dsa_attn: scores as Sᵀ = K·Qᵀ with q in registers (operand swap checked bit-identical) so two K tiles fit: tile j+1's Q·Kᵀ runs interleaved with tile j's P·V; next rows gathered during compute; 3 chunks per CTA (prefill), 16 heads per CTA (decode); a row's chunk partials merged by its last CTA from L2 — same bits")
E55_PATCH(46, dsa_select_fast, true,  "dsa_select: indexer logits with each row's query in registers over cp.async key tiles, k64 FP4 MMA where provably exact (exponent-spread guard, else the k32 chain); top-2048 by an exact 11-bit histogram threshold pre-filter refined only inside the threshold bin, by the row group's last CTA — same index sets")
E55_PATCH(47, dsa_vha_fast,    true,  "dsa_vha_gate (M > 16): one CTA per row, z kept in registers across the 32 heads (the base re-reads it per head from DRAM) — same bits")
E55_PATCH(48, dsa_bmm_dec,     true,  "decode dsa_bmm (W_UK / W_UV, M ≤ 16): a warp per 8 output columns, its weight rows loaded with coalesced 16-byte loads all in flight, then ldmatrix from a small per-warp tile — same bits")
E55_PATCH(50, mhc_dec,         true,  "mHC pre / post+pre at M ≤ 16: the 64 chunks of the fixed fp32 mixer order on 64 CTAs (fn by TMA before griddepcontrol.wait, programmatic launch), the last CTA finishes the row — same bits")
E55_PATCH(51, mhc_big,         true,  "mHC pre / post+pre at M > 16: P050's chunk kernels over blocks of 16 rows (partials in a shared 52 MB workspace) instead of one CTA per row re-reading the mixer — same bits")
E55_PATCH(60, f8_fuse_ops,     true,  "the norms / gates / SiTU / sums around the FP8 GEMMs (q, kv, latent RMSNorm; z ⊙ gate; SiTU; σ; + shared; the latent's MXFP8 copy) without their own launches: M ≤ 8 in the GEMM's prologue / epilogue (kv norm a side unit of the launch), M > 8 op + quantization in one launch and the epilogues in the GEMM's store (M ≤ 32) — same bits (needs the model.cc call sites)")
E55_PATCH(61, lin_pdl,         true,  "decode linear (M ≤ 32: router, compressor, indexer k, lm_head) launched as a programmatic dependent: its first stages' weights are requested under the previous kernel, the activation after griddepcontrol.wait, the next stages prefetched into L2 then — same bits")
E55_PATCH(62, lin_pack12_rc,   true,  "the router and HCA compressor linears also get P013's lossless 12-bit copy (decode reads 6 MB instead of 8 MB per call, fp32 outputs bitwise the bf16 path's; +6 MB per layer for the copy) (needs the model.cc upload flag)")
E55_PATCH(63, sparse_wire,     true,  "decode sampling (engine run(): greedy, or top_k ≤ 64 / top_p ≤ 0, any min_p / penalties): each rank sends its vocab half's top-64 records (P019 sample_cands, 520 B a row) instead of all-gathering the full fp32 rows (402 KB), then P019 sample_rows_sparse — the same tokens and probabilities; a NaN / inf in a half falls back to the full rows (needs the model.cc / model.h / engine.cpp changes)")
E55_PATCH(64, f8_pf_next,      true,  "decode FP8 GEMM (M ≤ 32): right after griddepcontrol.wait each warp prefetches its next 8 weight blocks into L2 (the first 8 were requested under the previous kernel), so DRAM keeps streaming while the activation is staged / quantized — same bits")
E55_PATCH(65, moe_combine,     true,  "prefill MoE experts (M > 64): the combine in the down kernel's epilogue — ordered fp32 chains per (row, 64 latent dims), the running sum in L2 (latent blocks in 4 passes), a pair applied by whoever finds its chain at its slot, else parked and applied by the owner that reaches it (lock-free) — instead of the per-pair fp32 y round trip + k_combine; the routing plan in one launch — same bits")
E55_PATCH(66, moe_fused,       true,  "decode / verify MoE (M ≤ 32): routing + the latent's MXFP8 (or fc1's copy) + experts + combine as one persistent launch — warp groups take up items, then down items that wait only on their expert's up items, the last per latent block combines; each distinct expert's weights read once, scales as one 128-B load a stage — instead of moe_route + act_quant + the expert launches — same bits (needs the model.cc call site)")
E55_PATCH(70, hca_attn_ws,     true,  "hca_attn at M > 8 (P041's 512-dim launches): each K tile dequantized once into shared memory for both Q·Kᵀ and P·V, 4 score warps (q in registers, Sᵀ = K·Qᵀ) and 8 P·V warps that also gather the next tiles, named barriers; the earlier chunk's partial merged with batched loads; o / zp leave by TMA bulk copies — same bits; prefill 4096 rows 3.44 → 2.77 ms (ctx 0), 4.16 → 3.53 ms (16K)")
E55_PATCH(71, dsa_attn_ws,     true,  "prefill dsa_attn (P045's 32-head launches): two groups of 4 score warps (q in registers, a head's 32 keys in one warp) alternating tiles and handing over the running max / sum, 8 P·V warps that also gather the K tiles, named barriers — same bits; 4096 rows ×1.18 over P045")
E55_PATCH(72, mhc_fuse,        true,  "mHC pre / post+pre at M ≥ 256 in one launch: P050's chunk CTAs, and the last chunk CTA of each 16-row block finishes those rows while their R' and partials are in L2 (P051 re-reads R' from DRAM in a second kernel) — same bits; M = 4096 post+pre 2.84 → 2.14 ms")
E55_PATCH(73, dsa_bmm_f8,      true,  "decode W_UK / W_UV (M ≤ 16) from kv_b_proj's own FP8 bytes and block scales (dequantized in the kernel to the same bf16 operands) instead of the bf16 copy: half the bytes — same bits; 0.040 → 0.026 / 0.053 → 0.031 ms per call (cold) (needs the model.cc upload and call sites)")
E55_PATCH(74, hca_side,        false,  "decode HCA (hca_fuse): the compressor projection on a side stream (events) beside the q / kv GEMMs, joined before hca_pre on group-closing steps, else before hca_post — same kernels, same bits; harness −0.22 ms/step over 37 layers (needs the model.cc stream / events) — off since 0.5.0: inline is faster in the step (s7, same process order: 1 row 31.3 → 30.9 ms, verify 5 / 16 rows 49.7 / 78.1 → 49.3 / 77.8; the side stream waited ~8.6 µs a layer)")
E55_PATCH(75, ar_lanes,        true,  "prefill (M ≥ 1024): attention + mHC in lanes (≤ 4 per 8192-row FFN part, ≤ 4096 rows each), each lane's VHA z / o_proj all-reduce on a highest-priority comm stream under the other lanes' compute; the FFN once per ≤ 8192-row part, its shared-expert all-reduce under the experts, the latent's per lane under the next layer — same bits; 4096-row chunk 1948–2002 → 1717–1776 ms, 16K chunks 2,480 tok/s (needs the model.cc lanes; chunks > 4096 rows always run in lanes)")
E55_PATCH(76, rdma_gather,     true,  "all-gathers (logits rows, row pieces, 8-byte rows up to 16 KiB) over P001's RDMA transport instead of NCCL — same bytes; logits R = 1 / 4: 145 / 286 → 35 / 93 µs (R = 16 now one fused kernel; not re-measured)")
E55_PATCH(77, ar_pdl,          true,  "decode-size all-reduces / all-gathers launched as programmatic dependents (griddepcontrol.wait first): resident when the previous kernel ends — same bits; −2.2…2.7 µs a call (decode −0.33 ms/step at M = 1, −1.0 at M = 8)")
E55_PATCH(78, tp_split,        true,  "steps of ≤ 16 rows: HCA kv / compressor, MoE router / fc1 / fc2 read as this rank's column halves (views of the replicated weights with their K splits) + one all-gather per split point — same bits; −1.54 / −1.15 / −0.94 ms/step at M = 1 / 4 / 8 (needs the model.cc views)")
E55_PATCH(79, ar_staging,      true,  "RDMA staging 32 MiB per call instead of 8 (pinned 132 MiB instead of 36): a prefill chunk's lane all-reduces in one call each, no pipeline drain every 8 MiB — 50 / 134 MB 19.6 / 20.0 → 22.3 / 22.2 GB/s (transport alone 24.0; NCCL 20.6 / 21.3) — same bits")
E55_PATCH(80, draft_lm8,       false, "DSpark: the draft's base logits from an MXFP8 copy of this rank's lm_head half (e4m3, UE8M0 per 32; 412 MB instead of the 12-bit copy's 618) — drafts only, the accept test uses the logits they came from")
E55_PATCH(81, draft_lm4,       true,  "DSpark: the draft's base logits from an NVFP4 copy of lm_head (lin_make_nvfp4, from Plus P006; ~232 MB) — drafts only; wins over draft_lm8. With P082, N=4 single stream: draft 7.3 → 4.5 ms/round, accepted 0.455 → 0.444 of verified, +3.8 % tok/s")
E55_PATCH(82, markov8,         true,  "DSpark: the Markov bias from an MXFP8 copy of markov_w2 (e4m3, UE8M0 per 32: 26 MB a step instead of 51) — drafts only")
E55_PATCH(83, markov_topk,     false, "DSpark: the Markov bias only on each vocabulary half's top-64 base logits (P019 candidates; vLLM's top-k Markov option): no markov_w2 sweep, one small exchange a step — drafts only (sampled drafts: q = those candidates). Off: N=4 accepted 0.455 → 0.440 of verified ate the 1.6 ms it saves")
E55_PATCH(86, moe_pf_dn,       true,  "prefill MoE experts (M > 64): P065's combine epilogue per warp, not per lane — lane j holds pair j's chain state (P065's lock-free protocol), the 16 staged pairs' running sums move coalesced (256 B a pair, round trips batched) and stay in shared memory in place of y; 2 latent passes up to 4096 rows, 1 above (P065: 4 — GB10's L2 keeps only ~6 MB of dirty lines at speed) — same bits; layer 5, real routing: 4096 rows 11.45 → 10.84 ms, 8192 rows 16.99 → 16.31 ms per call")
E55_PATCH(88, hca_attn_pf,     true,  "prefill hca_attn_fused (M ≥ 64, P070's tile loop): the score warps run into the next row while the P·V warps finish the last (q bulk-prefetched to L2, staged raw in shared memory and prepped in place — P070 spilled it), the P·V warps merge in registers, transpose with shuffles and run the VHA chains in registers, o / zp stored straight from registers (no shared staging / bulk-copy wait / 384-thread VHA pass), K dequantized with one cvt per two e4m3 codes — same bits; M 1024 / 4096 at ctx 0: 0.690 → 0.527 / 2.736 → 2.022 ms, at 16K: 0.991 → 0.766 / 3.557 → 2.892 ms")
E55_PATCH(89, hca_pre_pf,      true,  "prefill hca_pre (M ≥ 65): 8-CTA clusters over 128-row ranges — KV rows, then P044's cluster compressor on the range's group-closing rows (group staged in shared memory, the base's per-dim chains in order, RMS sums through L2) instead of a 512-thread CTA walking 3 × 128 rows with one load in flight — same bits; M 1024: 0.124 → 0.045 ms (ctx 0), 0.114 → 0.047 (16K); M 4096: 0.176 → 0.160 / 0.178 → 0.155 (ckv not L2-resident)")
E55_PATCH(91, dsa_select_pf,   true,  "prefill dsa_select (M ≥ 32, < 65536 candidates a row): indexer logits with the keys on the k64 FP4 MMA's M side and the row's query in registers, the tree's first level inside a lane, tile m's epilogue beside tile m+1's MMAs, two CTAs an SM (one selects beside the other's MMAs); the selection in two passes over the logits (the threshold prefix's members kept aside, ≤ 256) — same lists; 1024 rows at 16K / 48K 2.24 → 1.51 / 6.32 → 3.99 ms, 4096 rows at 48K 25.1 → 15.3")
E55_PATCH(92, dsa_attn_pf,     true,  "prefill dsa_attn = P071 with the 64 KB chunk partials stored L2 evict_last (the gathered MLA rows no longer push them to DRAM before the merge) and the row merge's loads all in flight — same bits; 1024 / 4096 rows at 48K 4.46 → 4.07 / 18.2 → 16.6 ms (16K: −1 %)")
E55_PATCH(93, dsa_bmm_pf,      true,  "prefill W_UK / W_UV (dsa_bmm, M > 16): the base kernel with 128-row tiles for W_UK (K = 192) and 32-row tiles for W_UV (K = 512) instead of 64 — same bits; 1024 rows 0.30 → 0.26 / 0.31 → 0.29 ms, 4096 rows 1.16 → 0.99 / 1.15 → 1.11")
E55_PATCH(94, sp_resid,        true,  "prefill lanes (P075): sequence-parallel residual — each rank keeps R, the mHC post / pre, the norms and the replicated per-row projections (q_down + kv / q_a + kv_a, compressor, indexer k, router + routing, fc1, fc2 + shared sum, the FP8 / MXFP8 copies) for its half of every lane; the tensor-parallel parts read them all-gathered (the owner's bytes), o_proj / MoE latent / shared / dense FFN partials reduce-scattered (rank r's half gets the all-reduce's bf16 sum); logit and DSpark context rows exchanged from their owners — same bits (needs the model.cc lanes, comm reduce-scatter)")
E55_PATCH(95, embed_split,     true,  "the embedding table as vocabulary halves (−0.77 GiB a rank, fixed at load): each rank embeds its half's tokens, the rows exchanged by one all-gather (8 KiB a row) and each taken from the half that holds its token — same bytes (every step and the DSpark draft)")
E55_PATCH(97, lm12_only,       true,  "lm_head kept only as P013's lossless 12-bit copy (the bf16 copy never uploaded: −0.77 GiB per rank); every read goes through it — the target's logit rows and the draft's base logits (P080 / P081 off) by the decode kernel, > 64 rows by P098's kernel — same bits")
E55_PATCH(98, lin12_prefill,   true,  "prefill (M > 64) linears read P013's 12-bit copy (unpacked in registers to the same bf16 operands, the same chains and K-split sums), so the router and HCA compressor keep only P062's copy (−0.6 GiB per rank) — same bits (needs P062)")
E55_PATCH(100, a2a_attn,       true,  "P094 lanes: the attention's output side on the row owner — the heads-split attention core's o (this rank's 32 heads) goes to each row's owner by one exchange of half the lane's o rows (HCA 32 KiB, DSA 16 KiB a row), which runs VHA z (both partials, added as the all-reduce adds them), VHA out, wo_a, gate and o_proj (both K halves' bf16 partials, added as the reduce-scatter adds them) for its rows with all 64 heads, instead of the VHA z fp32 all-reduce (32 KiB a row) and the o_proj reduce-scatter; ring / state writes stay on every row — same bits (+1.54 GiB a rank: the peer's gate / wo_a / o_proj halves; fixed at load)")
E55_PATCH(101, a2a_sched,      true,  "P100 lanes: every lane's gates (both halves) and ring / state writes before the first exchange join — they need no exchange, so the exchanges get that time; the fronts stay all ahead of the attention halves (E55_A2A_AHEAD=1 / 2: 8192 rows 2375 / 2342, 16384 4903 / 4847 ms vs 2344 / 4623) — same bits; 8192 / 16384-row chunk 2372 / 4658 → 2344 / 4623 ms (staged exchange wait 116 → 87 ms)")
E55_PATCH(102, sp_late_shared, true,  "P094 lanes: the last 2 lanes' shared experts after the experts, so the latent reduce-scatters (issued right after the experts) run under them instead of under the next layer's first tail — same bits; with P101 8192 / 16384-row chunk 2344 / 4623 → 2337 / 4598 ms (E55_SP_LATE=1: 2332 / 4594, 4: 2365 / 4752)")
E55_PATCH(103, f8_tile,        true,  "prefill FP8 block GEMM (M ≥ 256, K split 1 or 2; split 4 stays on P031): 128×128 tiles of 4 warps (64×64 each: half P031's shared / L2 bytes per MMA), 2 CTAs/SM, a K split of 2 as a 2-CTA cluster (partial halves through L2 in the caller's workspace, discarded after use, summed in split order), scale words staged per 512 k, weights requested before griddepcontrol.wait — same bits; M = 1024: o_proj (K 8192) 0.547 → 0.459 ms, wo_a → o_proj 0.654 → 0.561, q_up + gate 0.486 → 0.447; dense gate/up 158–163 TFLOPS (P031 129–134)")
E55_PATCH(104, f8_tile_epi,    true,  "with P103: P060's M > 32 epilogues (σ, + e, the MXFP8 copy) in the GEMM's store instead of a k_epi launch; kEpiMulQ128 (M ≥ 2048): z ⊙ gate quantized as o_proj's FP8 activation in wo_a's store (no k_prep, no z round trip) — same bits; fc2 + shared M = 2048 / 4096 0.522 / 1.112 → 0.430 / 0.867 ms, q_b + gate σ + iq 1.181 / 2.363 → 0.941 / 1.822 (needs the model.cc call site for kEpiMulQ128)")
E55_PATCH(105, f8_tile_chain,  true,  "with P103 + P033: the 2nd / 3rd GEMM of an f8_forward_multi group at M ≥ 256 (q_up + gate, q_b + gate + iq: one activation, nothing of each other read or written, ≤ 1 with a K split) waits for its predecessor (griddepcontrol.wait) after its main loop instead of before it — its CTAs compute in the previous GEMM's last wave and it still cannot finish before it — same bits; q_b + gate + iq M = 512 / 1024 0.286 / 0.515 → 0.260 / 0.477 ms, q_up + gate 0.253 / 0.437 → 0.244 / 0.424")
E55_PATCH(106, mhc_prefill,     true,  "mHC post + pre at M ≥ 256 (prefill): P072's grid with a CTA on 2 row blocks of its chunk (fn brought once, the 2nd block's inputs in flight under the 1st block's partials), a lane keeping 4 rows' chains (one fn load for 4 rows), a block's finish after the CTA's own blocks (no finisher cascade), its 64 partial loads in flight per sum and its collapse 4 rows at a time (64 threads doing 4 base threads' work each, the base's reduction order) — same bits; post + pre M = 512 / 1024 / 2048: 302.6 / 568.6 / 1087.8 → 286.0 / 527.5 / 977.0 µs")
E55_PATCH(107, mhc_rows_pdl,    true,  "mHC at 2 ≤ M ≤ 16 (verify; P050's two launches): the row kernel allows the dependent launch right after its griddepcontrol.wait, so the next kernel's prologue (fn / weight bulk copies) runs under the row finish, as on P050's M = 1 path — same bits; post + pre M = 4 / 8, mixer calls back to back: 15.6 / 18.2 → 14.0 / 15.7 µs (M = 1 unchanged)")
E55_PATCH(110, dsa_attn_ep,    true,  "prefill dsa_attn (P092's launches): each score warp releases the P·V warps for a tile right after storing its P and f, before its tile sum / running-sum hand-off (same operations, same order) — off the tiles' K-buffer dependency loop — same bits; 1024 rows at 16K 3.50 → 3.40 ms")
E55_PATCH(114, lin_pair,       true,  "decode / verify (M ≤ 32): the router's / HCA compressor's two P078 column halves as one launch (lin_forward_f32_pair: both halves' row blocks in one grid, each storing its own output) instead of two — same bits; pair cold, M 1 / 4 / 8: 28.8 / 28.7 / 28.9 → 20.5 / 20.5 / 20.5 µs (needs the model.cc call sites)")
E55_PATCH(115, lin_small,      true,  "decode linear (M ≤ 32), grids of few 16-row tiles and ≤ 2 K splits (the router / compressor halves, P114's pair): one-warp CTAs (4× the CTAs) with 7 stages in flight each, most requested before griddepcontrol.wait — same bits; pair (+ P114) behind a 10 µs predecessor, M 1 / 4 / 8: 18.7 → 13.6 / 14.6 / 14.6 µs (cold alone 20.5 → 20.5 / 20.6 / 21.5); halves without P114 28.8 → 26.6 µs")
E55_PATCH(118, ar_bf_post,     true,  "RDMA calls with a flag WRITE (P001 / P076 fused path, the decode / verify sizes above 8 KiB; the large path's chunks too): the data WRITE and its flag WRITE posted as two single-WQE posts — each reaches the NIC by BlueFlame (the WQE inside the MMIO write) instead of one doorbell for the pair that the NIC answers by fetching both WQEs from host memory — same bytes; decode collectives back to back (test_comm dec, calls × µs a step) M = 1 / 4 / 8: 2.15 / 3.17 / 3.96 → 2.12 / 3.01 / 3.67 ms (HCA z 256 KiB 26.5 → 24.7 µs)")
E55_PATCH(119, ar_host_seq,    true,  "RDMA small calls (P001 LL / fused, P076 gathers): the call's sequence number passed from the host (calls run on the GPU in issue order) instead of read from the device counter behind a block barrier, and no grid count at the end (no done atomics, no sweep-counter read) — the same doorbells, flags and bytes; the device count kept for the large path and once a stream was captured; with P118, calls × µs a step M = 1 / 4 / 8: 2.12 / 3.01 / 3.67 → 1.99 / 2.83 / 3.45 ms (−0.3…0.9 µs a call)")
E55_PATCH(120, ar_plan,        true,  "RDMA small-call plan (measured on the decode / verify collectives): LL only up to 8 KiB for all-reduces and all-gathers (16 KiB before; the fused path wins above), 4 KiB of data per LL block (8 KiB), the fused all-reduce 8 KiB per block up to 64 KiB (16 KiB), a gather's stream offsets by 32-bit division (64-bit) — same bytes, same places; with P118 + P119, calls × µs a step M = 1 / 4 / 8: 1.99 / 2.83 / 3.45 → 1.91 / 2.59 / 3.43 ms (M = 4 router|fc1 gather 10.3 → 7.8 µs)")
E55_PATCH(121, conf_gate,      true,  "DSpark: each round verifies a sequence's drafts only while the product of their confidences (σ of the draft's confidence head) stays ≥ its gate (server decode.gate; SpecSeq::verify) instead of all — lossless: only how many drafts are verified changes")
E55_PATCH(122, cap_verify,     true,  "DSpark: a round whose sequence may emit at most cap tokens (server: max_tokens, thinking budget / loop guard, an end-token draft) verifies at most cap − 1 drafts — the rows it would drop anyway; lossless")
E55_PATCH(125, kv_pool,        true,  "the growing caches (DSA MLA / indexer rows, HCA compressed entries) of all slots from one pool of 2 MiB chunks (core/kv_pool, CUDA VMM), mapped as a sequence grows, given back at reset; the pool takes the room left after a warm-up of the serving paths (min MemFree of both nodes − server.memory_free_gib), the same chunks on both ranks; context = per request at most — the same kernels on the same bytes (longer slot strides, address space only): same bits (needs the model.cc / dspark.cc / engine.cpp changes)")
E55_PATCH(129, draft_attn,     true,  "DSpark draft stage attention: hca_q_prep + hca_kv_rows + dsp_attn + vha_partial in one launch (q prep and the block's KV rows in shared memory, compact run-once code, the next tile's context rows loaded during the current one, conflict-free K dequant, MMA fragments loaded a step ahead, the tile softmax by 8 warps with each head's sum in key order, VHA partial from shared memory), with P060's fused GEMM calls around it as the target's — same bytes; one GPU, 7 rows: 51 → 31 µs a stage")
E55_PATCH(130, draft_chain,    true,  "DSpark greedy Markov chain (with P082): one launch + one all-reduce a step — the sweep takes the previous step's pick from its all-reduced candidates and its last CTA finishes the argmax; programmatic dependent of the all-reduce (first w2 pass requested before griddepcontrol.wait); odd steps sweep backwards (the previous sweep's tail is in L2) — same drafts; with P129, TP2 draft pass depth 4 / 7: 4.35 / 5.17 → 4.08 / 4.83 ms")
E55_PATCH(131, rdma_ce,        true,  "P001 large calls (> 1 MiB background, > 16 MiB otherwise): the staging copies by the copy engines (2-D per row piece), each chunk's doorbell and the wait for the peer's flag by stream memory operations — no SM copy / wait kernels (an all-gather none at all; all-reduce / reduce-scatter keep k_add, 8 blocks), 4 MiB chunks (≥ 4 a call), 2 groups ahead — same bytes, same sums; 32 MiB under a GEMM / DRAM-bound load: all-gather 6.2 / 1.0 → 11.9 / 4.4 GB/s, all-reduce 6.6 / 1.6 → 13.4 / 3.5 (alone 13.6 → 18.4, 20.3 → 19.0)")
E55_PATCH(132, rdma_numa,      false, "P001 staging region from cuMemCreate on the host NUMA node (GPU + CPU mapped at one address, NIC-registered) instead of cudaHostAlloc — after Pico (MIT) — same bytes (fixed at load); measured within noise (32 MiB all-reduce alone 20.3 → 21.5, with P131 under GEMM load 13.5 → 14.3 GB/s; gathers unchanged): off")
E55_PATCH(133, f8_tile_seq,    true,  "prefill FP8 block GEMM (M ≥ 256) on weights with a K split (split 4; split 2 with K ≤ 2048; full 128-row tiles): the splits' chains one after the other in K order in the same warps (warp tile 64 × 32: acc + running sum in registers) instead of P031's 64-row tiles / P103's 2-CTA clusters with partials through L2 — 128 × 128 tiles with 128-k stages for split 4, 128 × 64 at 2 CTAs / SM for split 2; P104's epilogues in its store, no workspace (P105 chains any number) — same bits; 8192-row chunk sites, isolated ms: q_down + kv (M 1024) 0.109 → 0.100, fc1 + MXFP8 0.180 → 0.150, gate σ ×2 0.255 → 0.205, fc2 + shared 0.225 → 0.212, shared gate/up (M 2048) 0.290 → 0.279")
E55_PATCH(134, f8_situ_epi,    true,  "with P133: the shared expert's SiTU and the down projection's FP8 activation (group 128) in the gate/up GEMM's store (kEpiSituQ128: a CTA computes the gate and the up rows of 64 columns, a 2-CTA cluster shares the 128-column amax through DSMEM) instead of the bf16 gate/up output and P060's SiTU k_prep — same bits; gate/up → SiTU → down M = 2048: 0.477 → 0.449 ms with P133 (needs the model.cc call site; the lanes path takes it only with P136 off — P136 runs the shared expert by its own calls)")
E55_PATCH(136, sp_shared,      true,  "P094 lanes: the MoE shared expert sequence-parallel — each rank runs both intermediate halves (its own and the peer's gate/up rows and down K half, through P100's Weights view of the peer: the same bytes and K splits) on its rows of each lane and adds the two bf16 partials as the reduce-scatter adds them (kEpiAdd bf16(h + e)) — no shared reduce-scatter (8 MiB a lane), the FFN front's gather without the FP8 input copy (6.2 → 2.1 MiB a lane): −2.0 GB a chunk on the link and its staging copies; lanes 0–1 before the experts, 2–3 after (E55_SPS) — same bits (+504 MiB a rank: the peer's shared halves; fixed at load); 8192-row chunk at 0: 2182.7 → 2154.8 ms (E55_SPS aaaa / ffaa / fffa / bbbb / ffff: 2166.9 / 2158.9 / 2165.9 / 2179.3 / 2171.8)")
E55_PATCH(140, dsa_sel_split,  true,  "P094 lanes with rows of more than 2048 indexer candidates: each rank runs dsa_select for its own half of the lane only; the peer's rows get their 2048 selected keys from the peer (an in-place all-gather of 8 KiB a row on the comm stream, issued right after the select, under q_pe / W_UK / the own rows' dsa_attn) and their window / count from dsa_select_tail (a function of the position); dsa_attn runs on the own rows, then (joined) the peer's — the same lists, same bits; with P141, 8192-row chunk at 0 / 49152: 2245 / 2540 → 2230 / 2445 ms (staged dsa_select 20.6 / 199.4 → 11.3 / 102.9 ms, the exchange hidden: dsa_attn own / peer 84.4 / 84.0 ms at 49152)")
E55_PATCH(141, dsa_q_own,      true,  "with P140: the indexer's query side — wq_b (out of the q_b group, on the quantized activation's own rows) and dsa_idx_prep's 64 query-head blocks — only for the rows this rank selects (the K rows for every row: the cache is replicated); none in a lane where no row has more than 2048 candidates (no select reads a query there) — same lists, same bits; staged, 8192-row chunk at 0 / 49152: q_b group + wq_b 17.3 / 17.6 → 13.0 / 13.5 ms, dsa_idx_prep 13.3 / 13.1 → 5.1 / 6.5 ms")
E55_PATCH(142, dsa_select_wide, true, "P091 dsa_select_pf also for rows with ≥ 65536 indexer candidates (P046 took them): the per-CTA counts stay 16-bit (≤ 4159 keys a CTA), the row's level-1 counts are 32-bit already; a row whose threshold 11-bit bin has ≥ 65536 members counts levels 2 / 3 in 32 bits (level 2 as two halves of 1024 bins: one more pass over the logits) — same lists; 4096 rows at 131072 (one GPU): 67.4 (P046) → 44.6 ms")
E55_PATCH(143, verify_joint,   true,  "DSpark (with P121): the verify lengths of a round's gate < 0 sequences (server decode.verify = \"cost\") chosen together — for every total of verify rows the largest confidence products Π σ(conf) (a prefix of each sequence's), then the total with the most expected emitted tokens per ms of the round (Engine::spec_round_cost: the server's measured ms by sequences and rows, rank 0's on both ranks) — instead of each sequence by its gate; lossless: only how many drafts are verified changes; TP2 sampled rounds T 1.0 / top_p 0.95, gate 0.3 → P143, derived tok/s: c = 1 thinking 57.7 → 60.7, code 68.5 → 68.1; c = 4 thinking 121.8 → 123.4, code 156.1 → 179.6 (content-confounded: accepted 3.11 → 3.35 a sequence at the same 22.2 rows)")
E55_PATCH(146, prefix_ckpt,    true,  "prefix checkpoints (server, needs P125): at every prompt's end and every server.checkpoint_every prefill tokens a slot copies what its history holds beyond the positional caches — the HCA window rings, the compressor's open group, the draft's context rows (2.9–21 MiB, KV pool chunks) — so a prompt that leaves the history part-way (a dropped reasoning, an edited message) restores the longest checkpoint ≤ the common prefix and reads only the rest, instead of reading from 0; an empty slot can take a busy slot's checkpoint (its rows copied) — same bits as a full prefill")
E55_PATCH(150, hca_attn_long,   true,  "prefill hca_attn_fused with ≥ 6 key chunks (P088 below): a row's chunks split into items of 2–3 chunks handed out row-major by an integer ticket counter to persistent CTAs (so a row's chunk partials live briefly), every partial stored evict_last, the row's last CTA (integer per-row counter) merges them from L2 with 256-byte loads in the post-transpose layout and discards them (P088's per-CTA slots went through DRAM: 1.08 / 8.6 GB a 2048-row call at 131K / 1M); P071's two score groups on even / odd tiles; K dequantized with integer ops (exact; zero / subnormal / NaN codes keep P088's cvt) — same bits (P088's tiles, chains, chunk merge order); one GPU, 2048 rows × 32 heads: 524,288 30.9 → 16.6 ms, 1,040,000 64.4 → 37.5 ms (18.4 / 17.2 → 34.2 / 29.5 TFLOPS)")
E55_PATCH(153, dsa_select_long, true, "prefill dsa_select with a row of ≥ 131072 indexer candidates (P091's logits bit for bit; P091 writes every logit as fp32 and reads it 2–3 times, its 8-row groups re-reading the key cache): an exact lower bound on the threshold's 11-bit bin from the counts of the row's finished CTAs (re-read every 8 stages), keys below it neither counted nor stored; the kept keys per (row, key split) compactly (≤ 256, uint16 offsets), the rest of a fuller split densely; key splits major in super-groups of ≤ 32 row groups (key tiles shared in L2, the bound tightens split by split); the selection one pass collecting the keys of bin ≥ b1 into the workspace's spare bytes, P091's levels / ties / merge on that set — same lists; 1024 rows (one GPU) at 131072 / 524288 / 1040000 candidates: 10.84 / 54.81 / 110.36 → 10.38 / 38.35 / 73.85 ms (80.5 / 102.0 / 103.6 → 77.1 / 71.4 / 69.3 ps a row·candidate; k64 MMA peak 412.6 TFLOPS = 39.7 ps); +≤ 35 MB (offsets, headers: 516 B a row·split, lazily)")
E55_PATCH(160, ctx_side,       false,  "DSpark round: the verify step's draft context rows (feature_projection → the 3 stages' ring rows, ~0.36 ms) on a side stream forked after the logits, joined on the GPU in the next draft pass after its first mHC pre — under the accept, its host round trip, the rollback and the pass's start; the same kernels on the same bytes. Serving rounds (8K, thinking, T 1 / top_p 0.95), non-verify ms a round: B 1 6.52 → 6.45, B 4 11.32 → 11.25 (the accept runs beside it: 0.30 → 0.57 / 0.42 → 0.70) — off: within noise at B 4, the accept slows beside it")
E55_PATCH(161, markov_back,    true,  "DSpark sampled drafts: the Markov step's markov_w2 sweep (k_markov) runs the vocabulary blocks backwards on odd steps, so a step starts on the w2 rows the previous step read last (26 MB a sweep, 24 MB of L2; P130's rule for the greedy chain) — every q value per element as before: the same drafts and q rows. One GPU, 7-step chains: 103.6 → 67.6 / 154.7 → 120.1 µs a step at 1 / 4 items; serving rounds, draft pass B 1 5.84 → 5.50, B 4 10.48 → 10.34 ms")
E55_PATCH(162, draft_qrows,    true,  "DSpark sampled drafts (with P076 over RDMA): each Markov step's q half gathered in place into full rows (P076's row gather: no halves_to_rows) — for a one-item step straight into the slot's q store, sampled there (no copy); a one-sequence verify's accept reads the q rows in the store (no copy into the accept buffer) — the same bytes: the same drafts, q rows and accepts. Serving rounds, non-verify ms: B 1 6.11 → 5.86, B 4 11.12 → 10.92")
E55_PATCH(163, markov_pipe,    false, "DSpark sampled drafts (with P162): each Markov step's sweep in 2 launches, the first part's q columns gathered on the comm stream (P075 async) under the second part's sweep, joined before the draw — the same values in the same places. Off: the split costs more than the overlap gives (serving rounds, non-verify ms B 1 5.86 → 5.99, B 4 10.92 → 11.08; one GPU, the split alone +9 / +15 µs a step at 1 / 4 items)")
E55_PATCH(164, mhc_verify,     true,  "mHC pre / post+pre at M ≤ 32 (decode, verify): one CTA a chunk at every M (rows in passes of 16: 41 KB, 2 CTAs an SM, one wave — P050 at M = 1 and P051 at M > 16 took two), the chunk partials register-blocked (a warp loads each fn value once for its R rows, the next loads in flight; the Σx² chains on their own warp), the rows' residual / post / comb lines prefetched into L2 before griddepcontrol.wait, the rows finished by a second launch at every M (norm weights loaded before its wait, only the 64 partials ahead of the coefficient chain) — same bits; post + pre behind a 10 µs predecessor, M 1 / 5 / 8 / 16 / 32: 14.27 / 12.87 / 14.49 / 20.29 / 26.86 → 8.98 / 12.69 / 13.12 / 15.04 / 19.05 µs")
E55_PATCH(165, lin_small2,     true,  "decode linear (M ≤ 32, P115's kernel): a grid whose one-warp CTAs would need a second wave but two-warp CTAs fit one (the whole router / compressor at 17–32 rows: 64 tiles × 2 K splits) as 64 two-warp CTAs instead of lin_kernel's 32 four-warp ones (16 SMs idle) — same bits; whole router / compressor at M = 32 behind a 10 µs predecessor: 33.50 / 33.91 → 30.64 / 30.90 µs")
E55_PATCH(168, copy_draft,     true,  "copy drafts (server decode.copy, server/copy_draft.py): a round of one decoding request whose reply repeats text its history holds verifies the tokens that followed that text there (Engine::spec_copy, ≤ logit_rows rows) in place of DSpark's drafts — every verify row drawn as plain decoding draws it (greedy argmax; sampled: the request's settings, the token's position as the Philox counter), a copied token kept while the draw equals it: the tokens of plain decoding, lossless; rollback as a DSpark round; no DSpark draft while the copy goes on")
E55_PATCH(172, hca_attn_long2,  true,  "prefill hca_attn_fused with ≥ 5 key chunks (P150 took ≥ 6, P088 5): P150 with the P·V warps dequantizing the next-but-one K tile word by word between their k-step MMAs (stored after every P·V warp has read the buffer) instead of in one burst beside the other score group's chain, a key's 8 gather pieces on contiguous 64-byte runs, the RoPE angles before the item handshake, equal row passes, its own counters — same bits (P150's tiles, chains, chunk merge order); one GPU, 2048 rows × 32 heads (an 8192-row chunk's lane): 131,072 (P088) 4.54 → 4.49 ms (P088 measured 4.5–5.5 ms across runs — its per-CTA chunk slots leave L2, inferred; P172 4.49–4.62), 524,288 16.22 → 15.73 ms (2.60× the bf16 MMA floor; time ~linear in the SMs used: a per-SM limit, the 128-register cap of 512 threads)")
E55_PATCH(176, zc_a2a,         true,  "P100 lanes (needs P001 + P131): the o exchange lands zero-copy — each lane's peer half goes as one put straight into the peer's NIC-registered receive rows (rdma_ar zc_alloc: cuMemCreate on the host NUMA node, GPU + CPU mapped, registered on both rails; the own halves of all lanes compact, fixed at load), the sender staging it by the copy engine as P131 (ready / sent rendezvous through the proxy, stream-memop doorbells and waits), attn_own reading the peer's heads from there — no receive-side copy; q_ / o_ stay cudaMalloc (registered memory is not kept in L2 across kernels) — the same bytes (+130 MiB registered pinned a rank at 8192 rows)")
E55_PATCH(180, hca_attn_long3,  false, "prefill hca_attn_fused with 5 … 48 key chunks (P172's range) as a warp-specialized pipeline (setmaxnreg budgets): 4 producer warps (tickets, K gather, exact dequant into the 2 K buffers), 4 score warps of 16 heads (S = Q·Kᵀ, q as A fragments in registers, 4 MMA chains a tile, the item's q prepped between tiles), 8 P·V warps (P172's P·V, partials, merge + VHA); one tile stream per CTA — same bits; OFF: not faster than P172 (one GPU, 2048 rows × 32 heads, median of 25: 131,072 / 524,288 / 1,040,000 4.48 / 15.72 / 39.35 → 4.79 / 16.52 / 38.97 ms, 2.90 / 2.73 / 3.30× the bf16 MMA floor) — the 2-buffer cycle (K free → refill → score chain → softmax ≈ 10k cycles a tile pair) needs registers the file lacks beside q and the accumulators")
E55_PATCH(190, moe_fused64,    true,  "with P066: decode / verify MoE at 33 … 64 rows (DSpark verify / draft steps of 5–8 sequences) as P066's one persistent launch (p190_moe_fused_mid.cuh: ring stages of 64 pairs, ≤ 8 n8 tiles, 64-bit expert row masks, 3 union pair indices a thread; 72 KB dynamic shared, 1 CTA an SM) instead of the base's 7 launches (route, act_quant, plan ×2, scan, experts<16>, combine) — the same routing, quantization, per-pair MMA chains and slot-order combine: same bits (test_moe.py --fused64). measured: 40–64 rows ×1.05 (route + experts), bitwise")
E55_PATCH(191, tp_split64,     true,  "with P078: its column-half views + one all-gather per split point (HCA kv / compressor, MoE router / fc1 / fc2) also at 17 … 64 rows (verify / draft steps of 3–8 sequences; P078 alone ≤ 16) — the same views with their K splits, the same bytes gathered: same bits; scratch 1 MiB (was 256 KiB). measured with P193: router / compressor pair 47 → 22 µs at 40 rows, bitwise")
E55_PATCH(192, mhc_verify64,   true,  "with P164: mHC pre / post+pre at 33 … 64 rows as P164's one CTA a chunk (p192_mhc_verify64.cuh: each pass's 16 x rows made right before the pass instead of all held in registers) instead of P051's 64 × ⌈M/16⌉ CTAs — P164's chains and row finish: same bits (test_mhc.py --v64). measured: post+pre a step 4.22 → 2.71 ms at 64 rows, bitwise")
E55_PATCH(193, lin_small64,    true,  "with P115: P114 / P115's decode linear kernel (one- / two-warp CTAs, P114 pairs) up to 64 rows (≤ 8 n8 row tiles) instead of lin_kernel at 33 … 64 — the same per-warp chains and rank-order split sums: same bits (test_lindec.py --rows 64). measured: router / compressor pair 47 → 22 µs at 40 rows, 56 → 28 at 64, bitwise")
E55_PATCH(194, moe_fused128,   false, "with P066: decode / verify MoE at 65 … 128 rows (DSpark verify / draft steps of 9–16 sequences: 72–128 rows) as P190's persistent launch (p194_moe_fused128.cuh): the rows in two 64-row halves, an expert with rows in both = two sub-experts with their own up items / counters / down items, the two halves' items of one weight tile on adjacent tickets (the second read from L2), P190's ring (72 KB dynamic, the prologue's 128-row masks in it; ~20 KB static, 1 CTA an SM), 1024 sub-expert counters (dcnt 8 KB) — instead of route + act_quant + P037 / P065 / P086's prefill experts — the same routing, quantization, per-pair MMA chains and slot-order combine: same bits (test_moe.py --only moe_fused128). measured: 65 ×1.07, 96 ×1.00, 112 ×0.96, 128 ×0.94 — off")
E55_PATCH(200, f8_mid,         true,  "FP8 block GEMM at 33 … 128 rows (verify / draft steps of 4–16 sequences; P030 below, today the base k_f8<64 / 128> + k_reduce or P031's tiles): P030's kernel with token tiles of 32 / 64 rows, a weight block's tiles adjacent CTAs (weights from DRAM once), the activation through a 2-stage cp.async ring of 128 k, the same K splits summed in rank order in a cluster, P034 / P060 epilogues in its store — same bits; taken only where measured faster (fp8.cu mid_takes: −1…−36 µs a call, p200_f8_mid.cuh)")
E55_PATCH(210, hca_attn_1p,    true,  "prefill hca_attn_fused under the prefill rule (11-28; p210_hca_attn_1p.cuh; NOT P088 / P150 / P172's bits): every prefill row (step_prefill(), any M, any key count; decode / verify / draft keep their kernels) as ONE online softmax over the row's keys in 16-key tiles from key 0 — no 256-key chunks, no fp32 partials, no merge, no workspace; scores = the 4 dims quarters' m16n8k16 chains summed ((q0 + q1) + (q2 + q3)); P bf16 against the running max; final with the sink as the base's one-chunk formula (quotient correctly rounded); q prep / VHA chains at the reference's rounding points; persistent CTAs of 384 threads (setmaxnreg 184 / 136): 4 producer warps gathering the FP8 rows and dequantizing exactly (straight-line integer dq8) into a 4-deep ring of 16-key bf16 K buffers (mbarriers), two free-running 16-head groups of 4 warps (HY4 P520's core); test_hca_pf.py: o at the current kernel's noise vs fp64, deterministic, chunk / lane invariant (bitwise); one GPU, 2048 rows × 32 heads, median of 9: ctx 0 / 16K / 32K / 64K / 131,072 / 524,288 1.061 / 1.478 / 1.774 / 2.555 / 4.480 / 16.21 → 0.954 / 1.142 / 1.397 / 2.022 / 3.296 / 10.85 ms (1.80× the bf16 MMA floor at 524,288)")
E55_PATCH(220, f8_mid32,       true,  "with P200: FP8 block GEMM at 17 … 32 rows (verify / draft steps of 3–4 sequences) on P200's kernel (MT 32, one token tile) for the shapes P030 cannot stage (K / split ≥ 2048 does not fit its 33 KB at MT 32: HCA wo_a / o_proj, DSA o_proj, dense) — today the base k_f8<32> + k_reduce; P030 keeps every shape it takes — same bits (P200 = P030 = base chains)")
E55_PATCH(221, dsa_sel_v32,    true,  "dsa_select in decode / verify steps (not prefill) of 17 … 64 rows: P046 with 1024-key splits, a CTA a row up to 32 rows, 8 rows above (P091 / P046 rpc 8 × 4096 keys took ≥ 32 rows: 12 CTAs at 4 × 8 rows and 9.6K candidates) — the same logits and lists (rows a CTA / key splits only schedule the work; integer histograms); cold 3 / 4 / 8 seqs × 8 rows at ~9.6K 0.100 / 0.211 / 0.215 → 0.082 / 0.101 / 0.162 ms (test_dsa.py --verify)")
